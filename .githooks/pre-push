#!/usr/bin/env bash
# pre-push hook — runs leak-scan against the commits about to be pushed.
# To enable in your local clone: bash scripts/install-hooks.sh
#
# stdin format from git: <local_ref> <local_sha> <remote_ref> <remote_sha>
# We scan the range remote_sha..local_sha for each ref being pushed.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCAN="$REPO_ROOT/scripts/leak-scan.sh"

ZERO=0000000000000000000000000000000000000000
EXIT=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Skip ref deletion
    if [[ "$local_sha" == "$ZERO" ]]; then
        continue
    fi
    # New ref (no remote counterpart) — scan against merge base with main if
    # possible, otherwise the empty tree
    if [[ "$remote_sha" == "$ZERO" ]]; then
        base="$(git merge-base "$local_sha" origin/main 2>/dev/null || git hash-object -t tree --stdin </dev/null)"
    else
        base="$remote_sha"
    fi
    range="${base}..${local_sha}"
    bash "$SCAN" --range "$range" || EXIT=1
done

exit $EXIT
