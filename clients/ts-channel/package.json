{
  "name": "@wiztheagent/openclaw-ironmesh-channel",
  "version": "0.1.0-alpha.1",
  "description": "OpenClaw channel plugin that uses IronMesh as transport. Lets OpenClaw agents see other mesh peers as contacts and exchange messages over the encrypted local-first mesh.",
  "license": "MIT",
  "author": "WizTheAgent",
  "homepage": "https://ironmesh.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/WizTheAgent/IronMesh",
    "directory": "clients/ts-channel"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@wiztheagent/ironmesh-client": "file:../ts"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "openclaw",
    "channel",
    "plugin",
    "ironmesh",
    "mesh",
    "agent",
    "p2p",
    "decentralized"
  ]
}
