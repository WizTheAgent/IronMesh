{
  "name": "@wiztheagent/openclaw-ironmesh",
  "version": "0.2.0",
  "description": "OpenClaw channel plugin that uses IronMesh as transport. Lets OpenClaw agents see other mesh peers as contacts and exchange messages over the encrypted local-first mesh.",
  "license": "MIT",
  "author": "WizTheAgent",
  "homepage": "https://ironmesh.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/WizTheAgent/IronMesh",
    "directory": "clients/ts-channel"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./entry": {
      "types": "./dist/entry.d.ts",
      "import": "./dist/entry.js"
    },
    "./config-schema": {
      "types": "./dist/config-schema.d.ts",
      "import": "./dist/config-schema.js"
    }
  },
  "files": [
    "dist",
    "vendor",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepack": "node scripts/vendor-client.js"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "openclaw",
    "channel",
    "plugin",
    "ironmesh",
    "mesh",
    "agent",
    "p2p",
    "decentralized"
  ],
  "openclaw": {
    "extensions": [
      "./dist/entry.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3"
    },
    "build": {
      "openclawVersion": "2026.3.8"
    },
    "channel": {
      "id": "ironmesh",
      "label": "IronMesh",
      "blurb": "Send and receive messages over the IronMesh peer-to-peer mesh. End-to-end encrypted, no cloud, your network only.",
      "docsPath": "https://ironmesh.org/docs/openclaw",
      "systemImage": "shield.fill"
    }
  }
}
