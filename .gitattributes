# Normalize line endings across platforms.
# Text files: checked out with the OS's native line ending, stored as LF.
* text=auto eol=lf

# Explicit LF for cross-platform build / script files
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.py        text eol=lf

# Explicit CRLF for Windows-only files (not shipped, but just in case)
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary: never touch
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.tar.gz    binary
*.whl       binary
*.db        binary
