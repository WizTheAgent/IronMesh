# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl

# Virtual environments
.venv/
venv/
env/

# Testing
.pytest_cache/
.hypothesis/
.coverage
htmlcov/
coverage.xml
.ruff_cache/
.mypy_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
temp.log
temp2.log
logs/
# Runtime lock/sentinel files — but the dependency lockfile is tracked.
*.lock
!requirements.lock

# Keys (NEVER commit secrets)
keys.json
*.pem
*.key
passphrase
.ironmesh/
.reticulum/

# Environment-specific leak-scan denylist — sourced by scripts/leak-scan.sh,
# must never be committed (a public denylist of private identifiers would
# itself be a leak)
.leak-patterns.local

# SQLite
*.db
*.db-shm
*.db-wal
*.sqlite3

# Benchmark output
tests/harness/*.csv
tests/harness/bench_results*.csv
tests/harness/baseline*.csv
tests/harness/chaos*.csv
tests/harness/smoke_results.csv
tests/harness/v072_baseline.csv
tests/harness/final_chaos*.csv

# Backup archives
*.tar.gz
*.bak
*.bak-*
*.broken

# Claude-specific workspace artifacts
.claude/

# Internal / work-in-progress artifacts (audit prompts, deployment notes,
# agent prompt fragments, internal release plans, bug investigations,
# audit reports) — never ship in public releases. Move them to a private
# location outside the repository instead.
.internal/
docs/v*_PLAN.md
docs/AUDIT_*.md
docs/BUG-*.md
docs/*_GAPS.md
docs/*_INTERNAL.md
IRONMESH_V*_ROADMAP.md

# Node tooling — clients/ts/ has its own node_modules; npx invoked from
# the repo root can also drop one here. clients/ts/package-lock.json
# stays tracked for reproducible builds.
node_modules/

# Golden 0.9.4.2 existing-state fixture: deliberately committed test
# artifacts written by the released wheel (throwaway identity, test
# passphrase published in manifest.json). Without these the cross-version
# migration tests skip. Lock files stay ignored.
!tests/fixtures/existing_state/v0_9_4_2/keys.json
!tests/fixtures/existing_state/v0_9_4_2/data.db
!tests/fixtures/existing_state/v0_9_4_2/audit.log
